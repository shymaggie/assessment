# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，不要提交。
# 所有键都必须存在（agent-compose.yml 用 ${VAR} 插值，缺键会让 `ac up` 报错）；不需要的留空即可。
# 更安全的做法：把本文件放到工作区挂载目录之外，并在 agent-compose.yml 中改 env_file、
# 宿主机直跑时用 OCTOBUS_ENV_FILE 指向它（见 docs/SECURITY.md）。

# OctoBus 网关地址（guest 容器内经 docker 网络服务名访问，与 call_octobus._base() 一致）
OCTOBUS_BASE_URL=http://octobus:9000
# capset retester 的访问令牌（由 octobus capset add-token ... --token-stdin 生成，仅存 .env 与 OctoBus 库）
OCTOBUS_TOKEN_RETESTER=replace-with-your-token

# 被测目标基址：data/vulns.json 里的 {{TARGET_BASE}} 展开为该值。
# 必须与探针实例的 allowedHosts 一致（部署脚本 deploy/bootstrap.sh 已统一配置）。
RETEST_TARGET_BASE=http://172.17.0.1:8081

# 水平越权（IDOR）复测所需的两个测试账号会话，值为完整请求头值（默认 Cookie）。
# 下面是 vulnlab 靶场的公开演示凭据；复测真实系统时请换成专用测试账号，切勿使用真实用户会话。
# 留空时对应漏洞会判 INCONCLUSIVE（MISSING_CREDENTIALS），不会跳过或猜测。
RETEST_SESSION_A=session=demo-token-a
RETEST_SESSION_B=session=demo-token-b

# 判定代码清单摘要的带外固定值（R-INT-01）。运行 python3 tools/pin_integrity.py 获得；
# 留空则退化为仓库内 integrity/pins.json 比对（只能发现漂移，不能防同时改代码和 pins）。
RETEST_PINNED_MANIFEST_SHA256=

# 运行数据目录（outputs/ 与 evidence/ 所在）。agent-compose 运行时在 compose 文件里固定为 /var/lib/retest，
# 不需要在这里设置；宿主机直跑（deploy/retest-pipeline.service、tools/notify.py）时指向 <项目>/runtime，
# 以便与 guest 读写同一份数据。留空则写项目内 ./outputs 与 ./evidence。
# RETEST_DATA_DIR=/home/agentadmin/agent-assessment/runtime

# 告警 Webhook（仅宿主机侧 tools/notify.py 使用，不要放进 agent-compose.yml 的 env）
# RETEST_ALERT_WEBHOOK=https://example.com/hook
